# W10 demo — copy to `.env.demo` ONLY if the default doesn't work for you.
#
# Default (used when .env.demo is absent):
#   postgresql://<your OS username>@localhost:5432/connectsphere_demo
# That is right for Homebrew and Postgres.app installs on macOS.
#
# If your Postgres uses the `postgres` user with a password (the official
# installer on Windows/macOS usually does), set it here instead.
#
# Rules enforced by `npm run demo:reset` / `npm run dev:demo`:
#   - the host must be localhost
#   - the database name must contain "demo"
# Never put the shared Supabase address here.

DEMO_DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/connectsphere_demo?schema=public"
