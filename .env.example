# Copy to .env and adjust for your machine. Never commit the real .env.

# --- Database -------------------------------------------------------------
# Postgres connection string, used by both Prisma and the app.
#
# Two URLs are needed because Supabase routes normal traffic through a
# connection pooler (PgBouncer), which migrations can't reliably run
# through — DATABASE_URL is for everyday app queries (pooled, port 6543),
# DIRECT_URL is for Prisma CLI commands like migrate (port 5432).
DATABASE_URL="postgresql://postgres.hrnnzgktczkynbzwagpx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.hrnnzgktczkynbzwagpx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Dedicated database for the e2e suite; created automatically on first run.
# Must NOT be the same database as DATABASE_URL — the suite truncates tables.
# Kept on local Postgres deliberately, not Supabase — no reason to run the
# test suite against the shared team database.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/connectsphere_test?schema=public"

# --- Supabase Storage (venue photos) --------------------------------------
# Project URL (different from the DATABASE_URL above) — Supabase dashboard,
# Settings > API.
SUPABASE_URL="https://hrnnzgktczkynbzwagpx.supabase.co"
# The "service_role" secret key (NOT "anon") — Settings > API. Bypasses all
# storage permissions, so this must stay server-side only: never expose it
# to the frontend, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# --- Auth (CLAUDE.md §8) --------------------------------------------------
JWT_SECRET="change-me-in-local-and-ci"
JWT_EXPIRES_IN="1h"
BCRYPT_SALT_ROUNDS=10

# --- HTTP -----------------------------------------------------------------
# Origin allowed to call this API from a browser (the Vite dev server).
WEB_ORIGIN="http://localhost:5173"
PORT=3000