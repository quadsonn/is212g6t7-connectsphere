# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string — used by both Prisma and the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/connectsphere?schema=public"

# Auth (CLAUDE.md §8)
JWT_SECRET="change-me-in-local-and-ci"
JWT_EXPIRES_IN="1h"
BCRYPT_SALT_ROUNDS=10

# HTTP
PORT=3000
