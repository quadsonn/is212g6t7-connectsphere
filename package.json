{
  "name": "connectsphere",
  "version": "0.0.1",
  "description": "ConnectSphere — event management system",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "concurrently -n api,web -c cyan,magenta -k --handle-input \"npm:start:dev\" \"npm:dev:web\"",
    "dev:web": "npm --prefix frontend run dev",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "prisma:seed": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed.ts",
    "prisma:seed:roles": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-new-roles.ts",
    "prisma:seed:us51": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-us51.ts",
    "prisma:seed:us40": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-us40.ts",
    "prisma:seed:us42": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-us42.ts",
    "prisma:seed:us44": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-us44.ts",
    "prisma:seed:us58": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-us58.ts",
    "prisma:seed:us45": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-us45.ts",
    "prisma:seed:us64": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-us64.ts",
    "prisma:seed:us65": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-us65.ts",
    "prisma:seed:us61": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-us61.ts",
    "prisma:seed:us66": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-us66.ts",
    "prisma:seed:notices": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-registration-notices.ts",
    "prisma:seed:venue-photos": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-venue-photos.ts",
    "prisma:seed:equip-unavailable": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/seed-equipment-unavailable.ts",
    "notices:trigger": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} scripts/trigger-registration-notices.ts",
    "venues:vocabulary-review": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} prisma/review-venue-vocabulary.ts",
    "check:equip-unavailable": "ts-node --compiler-options {\\\"module\\\":\\\"commonjs\\\"} scripts/check-equipment-unavailable.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "6.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "libphonenumber-js": "^1.13.15",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/test": "1.55.0",
    "@prisma/client": "^6.19.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
