// ConnectSphere — Prisma schema.
//
// First-pass domain model, transcribed from CLAUDE.md §5. This is the starting
// shape, not the final schema: refine as stories are estimated.
//
// Decisions made where §5 was ambiguous are marked "AMBIGUOUS:" below. Each one
// is a question for the team, not a settled answer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  EVENT_ORGANISER
  EVENT_COORDINATOR
  VENUE_STAFF
  TECHNICAL_SUPPORT_STAFF
  ATTENDEE
  // Requirement change 5: oversees the unassigned queue and assigns /
  // reassigns events to Event Coordinators.
  EVENT_COORDINATOR_LEAD
  // Requirement change 6: runs the Operational Safety Check before an event
  // can proceed to preparation.
  SAFETY_OFFICER
}

enum EventStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  // US-08: a distinct outcome from REJECTED — the Coordinator hands the
  // request back for the Organiser to amend and resubmit. Supersedes the
  // US-07 reading of "returned" as DRAFT plus a clarification note.
  RETURNED
  // US-09: the Coordinator has asked a question and is waiting on an answer.
  //
  // AMBIGUOUS / OVERLAP: this and RETURNED both mean "waiting on the
  // Organiser". US-08 asked for RETURNED, US-09 asks for this by name. They
  // are modelled as distinct because the workflows differ — a return makes the
  // request editable so it can be amended and resubmitted, a clarification
  // keeps it locked and expects only an answer. The customer should confirm
  // they really want both; see the US-09 summary.
  AWAITING_CLARIFICATION
  REJECTED
  PLANNING
  // US-11 AC-1 names this alongside PLANNING, so the two are modelled as
  // distinct stages: PLANNING is the Coordinator arranging things, this is
  // waiting on Venue Staff / Technical Support to decide on the booking and
  // equipment requests they have been sent.
  //
  // AMBIGUOUS: no story yet drives a transition into or out of it — E5/E6
  // will. It exists now because AC-1 requires the event to be able to show it.
  AWAITING_ARRANGEMENTS
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  APPROVED
  REJECTED
}

// US-23: what kind of entry a BookingDecision is. A REVERSAL overturns an
// earlier DECISION; it is a new row, never an edit of the old one (AC-6).
enum BookingDecisionKind {
  DECISION
  REVERSAL
}

// US-06: the predefined room layouts an Organiser may choose from.
//
// Shared deliberately — the venue suitability story reuses this rather than
// declaring its own list, so a layout requested on an event and a layout
// supported by a venue are the same value.
//
// AMBIGUOUS: exactly the four the acceptance criteria name. Any further layout
// (cabaret, u-shape, workshop) is a customer decision, not an invention.
enum RoomLayout {
  THEATRE
  CLASSROOM
  BANQUET
  BOARDROOM
  EVENT_HALL
  U_SHAPE
}

// US-06: accessibility requirements an Organiser may record.
//
// The AC lists three after "e.g."; the list below is the agreed fuller set.
// Anything not covered goes in free-text accessibilityNotes.
enum AccessibilityFeature {
  STEP_FREE_ACCESS
  WHEELCHAIR_ACCESSIBLE_LIFT
  ACCESSIBLE_PARKING
  ACCESSIBLE_RESTROOMS
  WHEELCHAIR_SEATING
  HEARING_LOOP
  NURSING_ROOM
}

// US-18: what a venue offers, as a controlled vocabulary so search can match
// it exactly. A starter set agreed with the team; additive changes
// (ALTER TYPE ... ADD VALUE) are cheap, so extend it as the customer refines.
//
// Step-free / ramp access is deliberately absent: it is STEP_FREE_ACCESS in
// AccessibilityFeature, and one concept must not live in two vocabularies.
enum Facility {
  PROJECTOR
  SCREEN
  SOUND_SYSTEM
  MICROPHONE
  STAGE
  WIFI
  VIDEO_CONFERENCING
  WHITEBOARD
  POWER_OUTLETS
  CATERING_KITCHEN
  AIR_CONDITIONING
}

// US-29: an equipment item's condition, shown in its full detail view.
// AMBIGUOUS: §5 lists no such enum — inferred from AC-2's "operational
// status". Defaults to OPERATIONAL since that describes every item until
// Technical Support records otherwise (no such endpoint exists yet).
enum EquipmentStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
}

// Venue catalogue lifecycle. Venue Staff draft a venue, then publish it so it
// becomes bookable and visible to coordinators.
enum VenueStatus {
  DRAFT
  PUBLISHED
}

enum RegistrationStatus {
  REGISTERED
  WITHDRAWN
}

// US-25 AC-2: the kinds of already-confirmed arrangement a planning edit can
// put at risk. "Confirmed" means an APPROVED VenueBooking or
// EquipmentReservation — see ARRANGEMENT_SENSITIVE_FIELDS in
// events/event-change.rules.ts for which fields affect which.
enum ConfirmedArrangement {
  VENUE_BOOKING
  EQUIPMENT_RESERVATION
}

// AMBIGUOUS: §5 gives EquipmentReservation a `status` but never defines its
// enum. Reusing BookingStatus would couple two independently-evolving
// workflows, so this is a separate enum with the same starting values.
//
// US-32: a commitment by Technical Support is created as APPROVED — the only
// status that holds units (see holdingReservationsWhere in
// equipment-availability.ts).
enum ReservationStatus {
  REQUESTED
  APPROVED
  REJECTED
  // US-33: given back because the event was cancelled. Holds nothing.
  RELEASED
}

// AMBIGUOUS: §5 says Notification.type is an enum but lists no values. These
// are inferred from the workflows the brief does describe (§1) and are the
// most likely thing here to need revising — extend as stories land.
enum NotificationType {
  EVENT_STATUS_CHANGED
  EVENT_CHANGE_REQUESTED
  // US-09 AC-4.
  CLARIFICATION_REQUESTED
  CLARIFICATION_ANSWERED
  // US-14 AC-3: a venue changed in a way that may invalidate bookings.
  VENUE_CHANGED_BOOKINGS_AFFECTED
  VENUE_BOOKING_DECIDED
  EQUIPMENT_RESERVATION_DECIDED
  // US-27 AC-3: sent to both the previous and the new Coordinator.
  EVENT_REASSIGNED
  REGISTRATION_CONFIRMED
  REGISTRATION_WITHDRAWN
}

// US-37 (E8): where a change request stands. Only PENDING is written so far;
// the review story will move it to APPROVED or REJECTED.
enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role

  // AC-5 lockout state. Counted per account, over a trailing window.
  failedLoginAttempts   Int       @default(0)
  failedWindowStartedAt DateTime?
  lockedUntil           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisedEvents       EventRequest[]         @relation("EventOrganiser")
  coordinatedEvents     EventRequest[]         @relation("EventCoordinator")
  registrations         Registration[]
  notifications         Notification[]
  clarificationMessages ClarificationMessage[]
  eventChanges          EventChange[]
  changeRequests        EventChangeRequest[]
  decidedChangeRequests EventChangeRequest[]   @relation("ChangeRequestDecider")
  managedVenues         Venue[]                @relation("VenueManager")
  requestedBookings     VenueBooking[]         @relation("BookingRequester")
  bookingDecisions      BookingDecision[]
  venueBlocks           VenueBlock[]

  @@index([role])
}

model EventRequest {
  id String @id @default(cuid())

  organiserId String
  organiser   User   @relation("EventOrganiser", fields: [organiserId], references: [id], onDelete: Restrict)

  // Null until a Coordinator is assigned during review (§1).
  coordinatorId String?
  coordinator   User?   @relation("EventCoordinator", fields: [coordinatorId], references: [id], onDelete: Restrict)

  // US-04: nullable so a partial draft can be saved. Completeness is enforced
  // at the DRAFT -> SUBMITTED transition, not by the column definitions —
  // see the note on validateForSubmission() in events.service.ts.
  name        String?
  purpose     String?
  description String?

  // US-25 AC-1: the running order, named by the story as a field the
  // Coordinator refines during planning. Free text — no structure is specified.
  programme String?

  // AC-1 (US-03) requires an event "type/category" at submission. The brief
  // lists no controlled vocabulary, so this is free text rather than an
  // invented enum. AMBIGUOUS: confirm whether the customer wants a fixed list.
  category String?

  proposedStart      DateTime?
  proposedEnd        DateTime?
  expectedAttendance Int?

  // AMBIGUOUS: the brief never enumerates layouts, so this stays free text
  // rather than an invented enum.
  // US-06: a selection from the predefined list, plus optional qualification.
  preferredLayout RoomLayout?
  layoutNotes     String?

  // US-06: structured requirements, plus optional free-text qualification.
  // Empty array means "none recorded" — these are preferences, not blockers.
  accessibilityRequirements AccessibilityFeature[] @default([])
  accessibilityNotes        String?

  // AMBIGUOUS: free text captured at request time. This is what the Organiser
  // *asks for*; the structured commitment lives in EquipmentReservation.
  // Kept unstructured until the equipment story (E6) needs to query it.
  equipmentNeeds String?

  // US-28 AC-2: the technical support the Coordinator has asked for (on-site
  // assistance, hybrid/video-conferencing setup). Free text — the AC gives
  // examples, not a fixed list.
  technicalSupportNeeds String?

  registrationEnabled Boolean     @default(false)
  status              EventStatus @default(DRAFT)

  // US-34/US-36: when attendees may register, and the last moment they may
  // withdraw. AMBIGUOUS: the brief gives no way to set these, so they are
  // nullable and, when null, fall back to the event's own start
  // (registration open immediately, closing and withdrawal cutoff at
  // proposedStart) — see registration-rules.ts.
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  withdrawalCutoffAt   DateTime?

  // US-05 AC-2: why a Coordinator rejected the request. Written by the review
  // story; US-05 only reads it.
  decisionReason String?

  // US-05 AC-3: what a Coordinator has asked the Organiser to clarify.
  //
  // Deliberately separate from status: AC-1 enumerates exactly the nine
  // EventStatus values and none of them is "awaiting clarification", so
  // clarification is a signal carried alongside status rather than a status
  // of its own. Per the US-03 transition map, requesting clarification returns
  // the request to DRAFT so the Organiser can edit and resubmit — this field
  // is what distinguishes that from a never-submitted draft.
  clarificationRequest String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clarifications        ClarificationMessage[]
  changes               EventChange[]
  changeRequests        EventChangeRequest[]
  equipmentRequirements EquipmentRequirement[]
  venueBookings        VenueBooking[]
  equipmentReservations EquipmentReservation[]
  registrations         Registration[]
  notifications         Notification[]

  @@index([organiserId])
  @@index([coordinatorId])
  @@index([status])
}

model Venue {
  id String @id @default(cuid())

  // US-13 AC-2: nullable so an incomplete venue can be saved as a draft.
  // Completeness is enforced at publish, and by a kCHECK constraint that only
  // permits nulls while the venue is a DRAFT.
  name     String?
  location String?
  capacity Int?

  // US-13 AC-4: the Venue Staff member who owns this entry. Drafts are visible
  // only to them.
  //
  // AMBIGUOUS: nullable, because venues created before this story have no
  // owner to backfill from. A draft with no manager is visible to nobody —
  // see the US-13 summary.
  managedById String?
  managedBy   User?   @relation("VenueManager", fields: [managedById], references: [id], onDelete: SetNull)

  // US-18: controlled vocabularies, so search can AND-match them reliably.
  //
  // accessibilityFeatures is the same AccessibilityFeature enum an Organiser
  // requests from (US-06), so a venue's offer and an event's need are directly
  // comparable. This reverses US-13's free-text choice; anything a venue offers
  // beyond the vocabulary (braille signage, quiet rooms) goes in the notes.
  facilities    Facility[] @default([])
  facilityNotes String?

  accessibilityFeatures AccessibilityFeature[] @default([])
  accessibilityNotes    String?

  // US-13: the shared US-06 lookup, so a layout a venue supports and a layout
  // an event requests are literally the same value rather than two strings
  // that happen to look alike.
  supportedLayouts RoomLayout[] @default([])

  // Free-text qualification for a layout not in the fixed list, mirroring
  // EventRequest.layoutNotes — kept separate from supportedLayouts since
  // that's a Postgres enum array and can't hold arbitrary text.
  layoutNotes String?

  operatingInfo String?
  imageUrls     String[] @default([])

  status VenueStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings VenueBooking[]
  blocks   VenueBlock[]

  @@index([capacity])
  // US-18 AC-7: search filters on published venues by capacity and by array
  // containment; GIN is the index type Postgres uses for @> on arrays.
  @@index([status, capacity])
  @@index([facilities], type: Gin)
  @@index([accessibilityFeatures], type: Gin)
}

model VenueBooking {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  // AMBIGUOUS: deliberately separate from EventRequest.proposedStart/End. The
  // booked slot can differ from the proposed one (setup/teardown, negotiated
  // times), and conflict detection must run against what is actually booked.
  start DateTime
  end   DateTime

  // US-21 AC-3: REQUESTED is the "pending" status the AC names — a request
  // that is not a confirmed booking until Venue Staff approve it (US-23).
  status         BookingStatus @default(REQUESTED)
  // US-23: the reason or note from the latest decision, kept here so lists
  // can show it without reading the history. BookingDecision is the record;
  // this is always written in the same transaction as the decision row.
  decisionReason String?

  // US-21 AC-6: whose request history this appears in. Nullable only because
  // rows created before US-21 had no requester recorded; the migration
  // backfills it from the event's coordinator where one exists.
  requestedById String?
  requestedBy   User?   @relation("BookingRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  // US-21 AC-1: required by the request DTO. Nullable for pre-US-21 rows.
  expectedAttendance Int?

  // US-21 AC-2: the event's requirements, copied onto the request when it is
  // submitted so Venue Staff see them without cross-referencing the event.
  //
  // AMBIGUOUS: a snapshot, not a live join. If the Organiser later edits the
  // event, an existing booking request keeps the requirements it was
  // submitted with — that is what Venue Staff reviewed and decided on.
  preferredLayout           RoomLayout?
  layoutNotes               String?
  accessibilityRequirements AccessibilityFeature[] @default([])
  accessibilityNotes        String?
  equipmentNeeds            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // US-23 AC-4/AC-6: every decision ever made on this request, oldest first.
  decisions BookingDecision[]

  @@index([requestedById])
  // Supports the (venueId, time range) conflict lookup in §5.
  //
  // Overlap prevention has two layers (US-24):
  //  - BookingsService re-checks at request and approval time under a
  //    per-venue lock, and reports hard/soft conflicts (booking-overlap.ts).
  //  - The database refuses two overlapping APPROVED bookings on one venue:
  //    EXCLUDE constraint "VenueBooking_no_overlapping_approved" (btree_gist,
  //    tsrange [start, end)), added by a hand-written migration because
  //    Prisma's schema language cannot express it. Prisma ignores it in diffs.
  @@index([venueId, start, end])
  @@index([eventId])
  @@index([status])
}

model Equipment {
  id String @id @default(cuid())

  // AMBIGUOUS: free text — the brief lists no equipment catalogue to enumerate.
  type String

  // US-29 AC-1: shown in the catalogue list "at a glance". Nullable because no
  // endpoint creates or edits equipment yet (that story is separate, E6) — an
  // item may simply not have these recorded.
  description String?
  location    String?

  totalQuantity  Int
  technicalSpecs String?

  // US-29 AC-2: shown only in an item's full detail view.
  operationalStatus EquipmentStatus @default(OPERATIONAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations         EquipmentReservation[]
  requirements         EquipmentRequirement[]
  changeRequestLines   EventChangeRequestEquipment[]

  @@index([type])
}

model EquipmentReservation {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  quantity Int
  start    DateTime
  end      DateTime

  status ReservationStatus @default(REQUESTED)

  // US-33 AC-3: when the reservation was released. Null unless RELEASED.
  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Availability is quantity-based: summing approved reservations that overlap
  // a window must stay within Equipment.totalQuantity. Same concurrency caveat
  // as VenueBooking — the index helps the query, the service enforces the rule.
  @@index([equipmentId, start, end])
  @@index([eventId])
  @@index([status])
}

model Registration {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  attendeeId String
  attendee   User   @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  status RegistrationStatus @default(REGISTERED)

  // US-34 AC-2: the form's fields. Name and email come from the User record.
  phone               String
  dietaryRequirements String?
  accessibilityNeeds  String?

  // US-36: when the attendee withdrew; null while registered.
  withdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AMBIGUOUS: one row per (event, attendee). Withdrawing flips status rather
  // than deleting, and re-registering flips it back — so the table holds
  // current state, not an audit trail. If the team needs registration history,
  // this constraint has to go and a separate events log takes its place.
  @@unique([eventId, attendeeId])
  @@index([attendeeId])
}

model Notification {
  id String @id @default(cuid())

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  type    NotificationType
  message String

  // AMBIGUOUS: nullable. Every notification type above relates to an event, but
  // making it required would block account-level notices later.
  relatedEventId String?
  relatedEvent   EventRequest? @relation(fields: [relatedEventId], references: [id], onDelete: Cascade)

  read      Boolean   @default(false)
  // Notifications page: when the recipient marked it read; null while unread.
  // Kept alongside `read` (set together) so existing readers are unaffected.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientId, read])
  // Notifications page: a recipient's inbox, newest first.
  @@index([recipientId, createdAt])
  @@index([relatedEventId])
}

// AC-4: logout must actually terminate the session. A signed JWT stays valid
// until it expires, so revocation needs server-side state — this table holds
// the jti of every token that has been logged out, until its natural expiry.
//
// NOTE: this is a deliberate departure from the "stateless" rationale in
// CLAUDE.md §2. See the AMBIGUOUS note in auth.service.ts.
model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

/**
 * US-09 — one entry in an event request's clarification thread.
 * Append-only by design: entries are never edited or deleted, which is what
 * makes the thread an audit trail (AC-5). The sender's role is not copied
 * here — it is read from the author, so a thread cannot disagree with the
 * user record.
 */
model ClarificationMessage {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  body String

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([authorId])
}

/**
 * US-26 — one edit to an event's information, as a single history entry.
 * One row per save rather than per field: the Coordinator changes several
 * fields at once and AC-2 asks "what was changed ... who ... when", which is a
 * property of the save. `changes` holds each field's previous and new value.
 * Append-only, like ClarificationMessage: rows are never edited or deleted,
 * which is what makes this an audit trail.
 */
model EventChange {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  changedById String
  changedBy   User   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  // [{ field, previous, next }] — see FieldChange in events/event-change.rules.ts.
  // JSON because the edited fields have different types (text, dates, enums,
  // arrays) and the history only ever displays them.
  changes Json

  // US-25 AC-2: the edit touched a field that an already-confirmed arrangement
  // depends on, so it needs review rather than being an ordinary edit.
  requiresReview       Boolean                @default(false)
  affectedArrangements ConfirmedArrangement[] @default([])

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([changedById])
}

/**
 * US-28 AC-1 — one line of equipment the Coordinator says the event needs.
 * Deliberately NOT an EquipmentReservation. This is the requirement ("two
 * projectors"), recorded during planning for Technical Support to review; a
 * reservation is what they then arrange against a specific catalogue item and
 * time window (E6). Keeping them apart means a requirement can be recorded
 * before, or without, anything in the catalogue matching it.
 * `equipmentType` is free text for the same reason Equipment.type is.
 */
model EquipmentRequirement {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // US-37: the catalogue item this line refers to. Nullable because lines
  // recorded before the link existed, or typed free-text, have none — those
  // are left out of change-request comparisons rather than guessed at.
  // `equipmentType` stays the display text either way.
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  equipmentType String
  // Positive — enforced by a CHECK constraint in the migration as well as
  // the DTO.
  quantity      Int
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([equipmentId])
}

/**
 * US-37 — an Organiser's proposal to change an event, awaiting review.
 *
 * A proposal, not an edit: the event row is never touched by this story, so
 * the original details stay as they were (AC "original details still show").
 *
 * Each proposed* column is null when that field is NOT being changed; only
 * fields that differ from the event are stored. Equipment cannot use null the
 * same way (an empty list is a real proposal — remove everything), so
 * `equipmentChanged` says whether `equipment` is part of the proposal, and
 * when it is, `equipment` is the complete proposed list.
 *
 * A partial unique index in the migration allows one PENDING request per
 * event; Prisma cannot express it.
 */
model EventChangeRequest {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  status ChangeRequestStatus @default(PENDING)
  reason String

  // US-38: the Coordinator's decision. All null while PENDING; a REJECTED
  // request always has a reason (CHECK constraint in the migration).
  decidedById    String?
  decidedBy      User?     @relation("ChangeRequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt      DateTime?
  decisionReason String?

  proposedStart      DateTime?
  proposedEnd        DateTime?
  proposedAttendance Int?

  equipmentChanged Boolean                       @default(false)
  equipment        EventChangeRequestEquipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([requestedById])
  @@index([decidedById])
}

/** US-37 — one line of a proposed equipment list, from the catalogue. */
model EventChangeRequestEquipment {
  id String @id @default(cuid())

  changeRequestId String
  changeRequest   EventChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  // Positive — enforced by a CHECK constraint in the migration as well as
  // the DTO.
  quantity Int

  @@unique([changeRequestId, equipmentId])
  @@index([equipmentId])
}

/**
 * US-23 — one recorded decision on a venue booking request.
 * Append-only, like ClarificationMessage: rows are never updated or deleted
 * by the application, which is what makes the history accountable (AC-4) and
 * a reversal a new action rather than an overwrite (AC-6).
 * AMBIGUOUS: deleted with its booking (Cascade). Bookings are only removed when
 * their event is, so this matches how the rest of an event's history goes.
 */
model BookingDecision {
  id String @id @default(cuid())

  bookingId String
  booking   VenueBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // AC-4: attributed to the Venue Staff member who made it.
  decidedById String
  decidedBy   User   @relation(fields: [decidedById], references: [id], onDelete: Restrict)

  kind BookingDecisionKind @default(DECISION)

  // The status the booking moved to: APPROVED or REJECTED.
  outcome BookingStatus

  // AC-2: required on rejection and reversal. AC-3: optional on approval.
  reason String?

  // AC-4: timestamped.
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([decidedById])
}

/**
 * US-16 AC-6 — a period a Venue Staff member has blocked out on a venue
 * (maintenance, a public holiday), shown on the calendar apart from bookings.
 *
 * AMBIGUOUS: a block also makes the slot unbookable — a new request or an
 * approval that overlaps one is refused. The story only asks for blocks to be
 * visible, but a "blocked" slot that can still be booked would defeat the
 * story's aim of not double-committing space. Confirm with the customer.
 */
model VenueBlock {
  id String @id @default(cuid())

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  start DateTime
  end   DateTime

  // e.g. "Annual maintenance". Required so the calendar can say why.
  reason String

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([venueId, start, end])
  @@index([createdById])
}
