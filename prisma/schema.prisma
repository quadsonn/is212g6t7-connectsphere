// ConnectSphere — Prisma schema.
//
// First-pass domain model, transcribed from CLAUDE.md §5. This is the starting
// shape, not the final schema: refine as stories are estimated.
//
// Decisions made where §5 was ambiguous are marked "AMBIGUOUS:" below. Each one
// is a question for the team, not a settled answer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  EVENT_ORGANISER
  EVENT_COORDINATOR
  VENUE_STAFF
  TECHNICAL_SUPPORT_STAFF
  ATTENDEE
}

enum EventStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  // US-08: a distinct outcome from REJECTED — the Coordinator hands the
  // request back for the Organiser to amend and resubmit. Supersedes the
  // US-07 reading of "returned" as DRAFT plus a clarification note.
  RETURNED
  // US-09: the Coordinator has asked a question and is waiting on an answer.
  //
  // AMBIGUOUS / OVERLAP: this and RETURNED both mean "waiting on the
  // Organiser". US-08 asked for RETURNED, US-09 asks for this by name. They
  // are modelled as distinct because the workflows differ — a return makes the
  // request editable so it can be amended and resubmitted, a clarification
  // keeps it locked and expects only an answer. The customer should confirm
  // they really want both; see the US-09 summary.
  AWAITING_CLARIFICATION
  REJECTED
  PLANNING
  // US-11 AC-1 names this alongside PLANNING, so the two are modelled as
  // distinct stages: PLANNING is the Coordinator arranging things, this is
  // waiting on Venue Staff / Technical Support to decide on the booking and
  // equipment requests they have been sent.
  //
  // AMBIGUOUS: no story yet drives a transition into or out of it — E5/E6
  // will. It exists now because AC-1 requires the event to be able to show it.
  AWAITING_ARRANGEMENTS
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  APPROVED
  REJECTED
}

// US-06: the predefined room layouts an Organiser may choose from.
//
// Shared deliberately — the venue suitability story reuses this rather than
// declaring its own list, so a layout requested on an event and a layout
// supported by a venue are the same value.
//
// AMBIGUOUS: exactly the four the acceptance criteria name. Any further layout
// (cabaret, u-shape, workshop) is a customer decision, not an invention.
enum RoomLayout {
  THEATRE
  CLASSROOM
  BANQUET
  BOARDROOM
}

// US-06: accessibility requirements an Organiser may record.
//
// AMBIGUOUS: the AC lists these three after "e.g.", so the real list is almost
// certainly longer. Only the named three are here — extending it is a customer
// conversation, and free-text accessibilityNotes covers anything missing in
// the meantime.
enum AccessibilityFeature {
  STEP_FREE_ACCESS
  HEARING_LOOP
  ACCESSIBLE_RESTROOMS
}

// Venue catalogue lifecycle. Venue Staff draft a venue, then publish it so it
// becomes bookable and visible to coordinators.
enum VenueStatus {
  DRAFT
  PUBLISHED
}

enum RegistrationStatus {
  REGISTERED
  WITHDRAWN
}

// AMBIGUOUS: §5 gives EquipmentReservation a `status` but never defines its
// enum. Reusing BookingStatus would couple two independently-evolving
// workflows, so this is a separate enum with the same starting values.
enum ReservationStatus {
  REQUESTED
  APPROVED
  REJECTED
}

// AMBIGUOUS: §5 says Notification.type is an enum but lists no values. These
// are inferred from the workflows the brief does describe (§1) and are the
// most likely thing here to need revising — extend as stories land.
enum NotificationType {
  EVENT_STATUS_CHANGED
  EVENT_CHANGE_REQUESTED
  // US-09 AC-4.
  CLARIFICATION_REQUESTED
  CLARIFICATION_ANSWERED
  // US-14 AC-3: a venue changed in a way that may invalidate bookings.
  VENUE_CHANGED_BOOKINGS_AFFECTED
  VENUE_BOOKING_DECIDED
  EQUIPMENT_RESERVATION_DECIDED
  REGISTRATION_CONFIRMED
  REGISTRATION_WITHDRAWN
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role

  // AC-5 lockout state. Counted per account, over a trailing window.
  failedLoginAttempts   Int       @default(0)
  failedWindowStartedAt DateTime?
  lockedUntil           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisedEvents       EventRequest[]         @relation("EventOrganiser")
  coordinatedEvents     EventRequest[]         @relation("EventCoordinator")
  registrations         Registration[]
  notifications         Notification[]
  clarificationMessages ClarificationMessage[]
  managedVenues         Venue[]                @relation("VenueManager")

  @@index([role])
}

model EventRequest {
  id String @id @default(cuid())

  organiserId String
  organiser   User   @relation("EventOrganiser", fields: [organiserId], references: [id], onDelete: Restrict)

  // Null until a Coordinator is assigned during review (§1).
  coordinatorId String?
  coordinator   User?   @relation("EventCoordinator", fields: [coordinatorId], references: [id], onDelete: Restrict)

  // US-04: nullable so a partial draft can be saved. Completeness is enforced
  // at the DRAFT -> SUBMITTED transition, not by the column definitions —
  // see the note on validateForSubmission() in events.service.ts.
  name        String?
  purpose     String?
  description String?

  // AC-1 (US-03) requires an event "type/category" at submission. The brief
  // lists no controlled vocabulary, so this is free text rather than an
  // invented enum. AMBIGUOUS: confirm whether the customer wants a fixed list.
  category String?

  proposedStart      DateTime?
  proposedEnd        DateTime?
  expectedAttendance Int?

  // AMBIGUOUS: the brief never enumerates layouts, so this stays free text
  // rather than an invented enum.
  // US-06: a selection from the predefined list, plus optional qualification.
  preferredLayout RoomLayout?
  layoutNotes     String?

  // US-06: structured requirements, plus optional free-text qualification.
  // Empty array means "none recorded" — these are preferences, not blockers.
  accessibilityRequirements AccessibilityFeature[] @default([])
  accessibilityNotes        String?

  // AMBIGUOUS: free text captured at request time. This is what the Organiser
  // *asks for*; the structured commitment lives in EquipmentReservation.
  // Kept unstructured until the equipment story (E6) needs to query it.
  equipmentNeeds String?

  registrationEnabled Boolean     @default(false)
  status              EventStatus @default(DRAFT)

  // US-05 AC-2: why a Coordinator rejected the request. Written by the review
  // story; US-05 only reads it.
  decisionReason String?

  // US-05 AC-3: what a Coordinator has asked the Organiser to clarify.
  //
  // Deliberately separate from status: AC-1 enumerates exactly the nine
  // EventStatus values and none of them is "awaiting clarification", so
  // clarification is a signal carried alongside status rather than a status
  // of its own. Per the US-03 transition map, requesting clarification returns
  // the request to DRAFT so the Organiser can edit and resubmit — this field
  // is what distinguishes that from a never-submitted draft.
  clarificationRequest String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clarifications        ClarificationMessage[]
  venueBookings         VenueBooking[]
  equipmentReservations EquipmentReservation[]
  registrations         Registration[]
  notifications         Notification[]

  @@index([organiserId])
  @@index([coordinatorId])
  @@index([status])
}

model Venue {
  id String @id @default(cuid())

  // US-13 AC-2: nullable so an incomplete venue can be saved as a draft.
  // Completeness is enforced at publish, and by a CHECK constraint that only
  // permits nulls while the venue is a DRAFT.
  name     String?
  location String?
  capacity Int?

  // US-13 AC-4: the Venue Staff member who owns this entry. Drafts are visible
  // only to them.
  //
  // AMBIGUOUS: nullable, because venues created before this story have no
  // owner to backfill from. A draft with no manager is visible to nobody —
  // see the US-13 summary.
  managedById String?
  managedBy   User?   @relation("VenueManager", fields: [managedById], references: [id], onDelete: SetNull)

  // AMBIGUOUS: modelled as string arrays rather than lookup tables. Adequate
  // for the filtering §1 describes; promote to their own tables if venues ever
  // need to be searched or managed by individual facility.
  facilities String[]

  // AMBIGUOUS: deliberately NOT the US-06 AccessibilityFeature enum. That enum
  // holds the three things an Organiser may *request*; a venue advertises many
  // more (braille signage, assistance-animal access, quiet rooms). Forcing
  // venues into the request vocabulary would discard information. Suitability
  // matching will need a mapping, or an expanded enum — see the US-13 summary.
  accessibilityFeatures String[]

  // US-13: the shared US-06 lookup, so a layout a venue supports and a layout
  // an event requests are literally the same value rather than two strings
  // that happen to look alike.
  supportedLayouts RoomLayout[] @default([])

  operatingInfo String?

  status VenueStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings VenueBooking[]

  @@index([capacity])
}

model VenueBooking {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Restrict)

  // AMBIGUOUS: deliberately separate from EventRequest.proposedStart/End. The
  // booked slot can differ from the proposed one (setup/teardown, negotiated
  // times), and conflict detection must run against what is actually booked.
  start DateTime
  end   DateTime

  status         BookingStatus @default(REQUESTED)
  decisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Supports the (venueId, time range) conflict lookup in §5.
  //
  // NOTE: this index makes the check fast but does NOT make it correct under
  // concurrency. A true guarantee needs a Postgres EXCLUDE constraint with
  // btree_gist, which Prisma's schema language cannot express — it would have
  // to be added via a hand-edited migration. Until then, overlap prevention
  // lives in the bookings service (CLAUDE.md §3.4).
  @@index([venueId, start, end])
  @@index([eventId])
  @@index([status])
}

model Equipment {
  id String @id @default(cuid())

  // AMBIGUOUS: free text — the brief lists no equipment catalogue to enumerate.
  type String

  totalQuantity  Int
  technicalSpecs String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations EquipmentReservation[]

  @@index([type])
}

model EquipmentReservation {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  quantity Int
  start    DateTime
  end      DateTime

  status ReservationStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Availability is quantity-based: summing approved reservations that overlap
  // a window must stay within Equipment.totalQuantity. Same concurrency caveat
  // as VenueBooking — the index helps the query, the service enforces the rule.
  @@index([equipmentId, start, end])
  @@index([eventId])
  @@index([status])
}

model Registration {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  attendeeId String
  attendee   User   @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  status RegistrationStatus @default(REGISTERED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AMBIGUOUS: one row per (event, attendee). Withdrawing flips status rather
  // than deleting, and re-registering flips it back — so the table holds
  // current state, not an audit trail. If the team needs registration history,
  // this constraint has to go and a separate events log takes its place.
  @@unique([eventId, attendeeId])
  @@index([attendeeId])
}

model Notification {
  id String @id @default(cuid())

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  type    NotificationType
  message String

  // AMBIGUOUS: nullable. Every notification type above relates to an event, but
  // making it required would block account-level notices later.
  relatedEventId String?
  relatedEvent   EventRequest? @relation(fields: [relatedEventId], references: [id], onDelete: Cascade)

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([recipientId, read])
  @@index([relatedEventId])
}

// AC-4: logout must actually terminate the session. A signed JWT stays valid
// until it expires, so revocation needs server-side state — this table holds
// the jti of every token that has been logged out, until its natural expiry.
//
// NOTE: this is a deliberate departure from the "stateless" rationale in
// CLAUDE.md §2. See the AMBIGUOUS note in auth.service.ts.
model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

/**
 * US-09 — one entry in an event request's clarification thread.
 * Append-only by design: entries are never edited or deleted, which is what
 * makes the thread an audit trail (AC-5). The sender's role is not copied
 * here — it is read from the author, so a thread cannot disagree with the
 * user record.
 */
model ClarificationMessage {
  id String @id @default(cuid())

  eventId String
  event   EventRequest @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  body String

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([authorId])
}
